meta {
  name: Ping
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/diagnostics/ping?count=3
  body: none
  auth: none
}

tests {
  test("200 with pong", function () {
    expect(res.status).to.equal(200);
    expect(res.body.message).to.equal("pong");
  });
  test("echoes or creates a correlation id", function () {
    expect(res.headers["x-correlation-id"]).to.be.a("string").and.not.empty;
  });
}
