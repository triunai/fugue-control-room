meta {
  name: Update customer (If-Match)
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/v1/customers/{{customerId}}
  body: json
  auth: inherit
}

headers {
  If-Match: {{etag}}
}

body:json {
  {
    "name": "Bruno Renamed",
    "email": "{{emailLower}}",
    "phone": null
  }
}

script:pre-request {
  bru.setVar("staleEtag", bru.getVar("etag"));
}

script:post-response {
  if (res.status === 204) {
    bru.setVar("etag", res.headers["etag"]);
  }
}

tests {
  test("204 with a new ETag and no body", function () {
    expect(res.status).to.equal(204);
    expect(res.headers["etag"]).to.not.equal(bru.getVar("staleEtag"));
  });
}
