meta {
  name: The check now marks the item as imported (not ready)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/import/check
  body: json
  auth: bearer
}

auth:bearer {
  token: {{importStaffToken}}
}

body:json {
  {
    "drafts": [
      {
        "key": "{{importKey}}",
        "claimantEmail": "{{selfEmail}}",
        "market": "SG",
        "line": "Motor",
        "policyNumber": "{{importPolicy}}",
        "incidentDate": "{{importDate}}",
        "incidentDescription": "Rear-ended at the lights (Bruno import)."
      }
    ]
  }
}

tests {
  test("imported points at the claim; ready is false", function () {
    expect(res.status).to.equal(200);
    expect(res.body[0].ready).to.equal(false);
    expect(res.body[0].imported.claimId).to.equal(bru.getVar("importClaimId"));
  });
}
