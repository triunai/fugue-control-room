meta {
  name: Staff cannot list roles: 403
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/roles
  body: none
  auth: none
}

script:pre-request {
  const res = await bru.sendRequest({
    method: "POST",
    url: bru.getEnvVar("baseUrl") + "/api/v1/auth/token",
    headers: { "Content-Type": "application/json" },
    data: { email: "staff@fugue.test", password: bru.getEnvVar("devPw") }, // secrets-scan:ignore
  });
  req.setHeader("Authorization", "Bearer " + res.data.accessToken);
}

tests {
  test("403", function () {
    expect(res.status).to.equal(403);
  });
}
