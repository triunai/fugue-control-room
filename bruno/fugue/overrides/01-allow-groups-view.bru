meta {
  name: Allow GROUPS_VIEW for self-service until tomorrow (204)
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/api/v1/overrides/{{selfUserId}}/GROUPS_VIEW
  body: json
  auth: inherit
}

body:json {
  {
    "isAllowed": true,
    "reason": "bruno demo",
    "expiresAt": "2099-01-01T00:00:00Z"
  }
}

script:post-response {
  if (res.status === 204) {
    bru.setVar("overrideEtag", res.headers["etag"]);
  }
}

tests {
  test("204 with the ETag a later change must send back", function () {
    expect(res.status).to.equal(204);
    expect(res.headers["etag"]).to.be.a("string");
  });
}
