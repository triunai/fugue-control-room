meta {
  name: Keyset paging, newest first, with a cursor header
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/audit?limit=2
  body: none
  auth: inherit
}

script:post-response {
  if (res.status === 200 && res.headers["x-next-cursor"]) {
    bru.setVar("auditCursor", res.headers["x-next-cursor"]);
    bru.setVar("auditFirstPageIds", JSON.stringify(res.body.map(function (r) { return r.id; })));
  }
}

tests {
  test("200 with two rows and a next cursor", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.length(2);
    expect(res.headers["x-next-cursor"]).to.be.a("string").and.not.empty;
    expect(res.headers["link"]).to.include('rel="next"');
  });
  test("newest first", function () {
    expect(res.body[0].occurredAt >= res.body[1].occurredAt).to.equal(true);
  });
}
