meta {
  name: Read the failure row back
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/audit?correlationId={{auditFailureCorrelation}}
  body: none
  auth: inherit
}

tests {
  test("one failure row with outcome and error code", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.length(1);
    expect(res.body[0].outcome).to.equal("failure");
    expect(res.body[0].errorCode).to.equal("customer.email_taken");
    expect(res.body[0].action).to.equal("customers.create");
    expect(res.body[0].changes).to.equal(null);
  });
}
