meta {
  name: Search the audit trail (needs the Meilisearch service; 503 search.unavailable without it)
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/audit/search?q=customers&limit=5
  body: none
  auth: inherit
}

tests {
  test("200 with hits and a total, or 503 search.unavailable when search is off", function () {
    if (res.status === 503) {
      expect(res.body.code).to.equal("search.unavailable");
    } else {
      expect(res.status).to.equal(200);
      expect(res.body.hits).to.be.an("array");
      expect(res.body.estimatedTotalHits).to.be.a("number");
    }
  });
}
