meta {
  name: Me without a token is 401
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/me
  body: none
  auth: none
}

tests {
  test("401 as problem+json", function () {
    expect(res.status).to.equal(401);
    expect(res.headers["content-type"]).to.contain("application/problem+json");
  });
}
