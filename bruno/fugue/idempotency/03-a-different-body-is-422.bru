meta {
  name: The same key with a different body is 422
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/customers
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: "{{idemKey}}"
}

body:json {
  {
    "name": "A different customer",
    "email": "other-{{idemEmail}}",
    "phone": null
  }
}

tests {
  test("422 idempotency.key_reused", function () {
    expect(res.status).to.equal(422);
    expect(res.body.code).to.equal("idempotency.key_reused");
  });
}
