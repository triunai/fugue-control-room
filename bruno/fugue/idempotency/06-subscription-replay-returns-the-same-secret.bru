meta {
  name: The replay returns the same secret, not a second subscription
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/webhooks/subscriptions
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: "{{idemHookKey}}"
}

body:json {
  {
    "name": "bruno idempotent hook",
    "url": "{{baseUrl}}/api/v1/dev/webhook-sink",
    "eventTypes": ["customer.*"]
  }
}

tests {
  test("201 replay with the same id and secret", function () {
    expect(res.status).to.equal(201);
    expect(res.headers["idempotent-replayed"]).to.equal("true");
    expect(res.body.id).to.equal(bru.getVar("idemHookId"));
    expect(res.body.secret).to.equal(bru.getVar("idemHookSecret"));
  });
}
