meta {
  name: Refresh rotates the token
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

script:pre-request {
  bru.setVar("usedRefreshToken", bru.getVar("refreshToken"));
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("refreshToken", res.body.refreshToken);
  }
}

tests {
  test("200 with a NEW refresh token", function () {
    expect(res.status).to.equal(200);
    expect(res.body.refreshToken).to.not.equal(bru.getVar("usedRefreshToken"));
  });
}
