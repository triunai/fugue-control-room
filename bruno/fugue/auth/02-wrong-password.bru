meta {
  name: Wrong password (401, same body as unknown email)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/token
  body: json
  auth: none
}

body:json {
  {}
}

script:pre-request {
  req.setBody({ email: bru.getEnvVar("adminEmail"), password: "definitely-not-it" }); // secrets-scan:ignore
}

tests {
  test("401 problem+json auth.invalid_credentials", function () {
    expect(res.status).to.equal(401);
    expect(res.headers["content-type"]).to.include("application/problem+json");
    expect(res.body.code).to.equal("auth.invalid_credentials");
  });
}
