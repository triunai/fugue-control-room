meta {
  name: Suspend customer
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/customers/{{customerId}}/suspend
  body: none
  auth: none
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("etag", res.headers["etag"]);
  }
}

tests {
  test("200 and Suspended", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("Suspended");
  });
  test("ETag header present", function () {
    expect(res.headers["etag"]).to.be.a("string").and.not.empty;
  });
}
