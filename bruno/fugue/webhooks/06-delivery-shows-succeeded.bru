meta {
  name: The deliveries API shows the delivery as succeeded
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/webhooks/deliveries?subscriptionId={{hookSubId}}&eventType=customer.created.v1
  body: none
  auth: inherit
}

tests {
  test("one succeeded delivery with a 200 from the receiver", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.length(1);
    expect(res.body[0].status).to.equal("succeeded");
    expect(res.body[0].lastStatusCode).to.equal(200);
  });
}
