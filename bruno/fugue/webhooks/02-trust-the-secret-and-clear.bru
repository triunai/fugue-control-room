meta {
  name: Tell the sink which secret to trust
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/v1/dev/webhook-sink/secret
  body: json
  auth: inherit
}

body:json {
  {
    "secret": "{{hookSecret}}"
  }
}

tests {
  test("204 No Content", function () {
    expect(res.status).to.equal(204);
  });
}
