meta {
  name: Sign in the claimant, another claimant and staff
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/me
  body: none
  auth: inherit
}

script:pre-request {
  async function login(email) {
    // One token per account per run: reuse it while it is younger than 10 minutes (the sign-in limiter stays on).
    const key = "tok_" + email.replace("@", "_at_");
    if (bru.getVar(key) && Date.now() - Number(bru.getVar(key + "_at") || 0) < 10 * 60 * 1000) return bru.getVar(key);
    const res = await bru.sendRequest({
      method: "POST",
      url: bru.getEnvVar("baseUrl") + "/api/v1/auth/token",
      headers: { "Content-Type": "application/json" },
      data: { email: email, password: bru.getEnvVar("devPw") }, // secrets-scan:ignore
    });
    bru.setVar(key, res.data.accessToken);
    bru.setVar(key + "_at", String(Date.now()));
    return res.data.accessToken;
  }
  bru.setVar("claimantToken", await login(bru.getEnvVar("selfEmail")));
  bru.setVar("otherClaimantToken", await login(bru.getEnvVar("self2Email")));
  bru.setVar("officerToken", await login("staff@fugue.test"));
  bru.setVar("claimPolicy", "BRU-" + Date.now());
  bru.setVar("incidentDate", new Date(Date.now() - 86400000).toISOString().slice(0, 10));
}

tests {
  test("signed in (the collection admin token answers /me)", function () {
    expect(res.status).to.equal(200);
  });
}
