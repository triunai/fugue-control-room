meta {
  name: Officer sets the reserve (SGD 1,000.00)
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/v1/claims/{{claimId}}/reserve
  body: json
  auth: bearer
}

auth:bearer {
  token: {{officerToken}}
}

headers {
  If-Match: {{claimEtag}}
}

body:json {
  { "amountMinor": 100000 }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("claimEtag", res.headers["etag"]);
  }
}

tests {
  test("200", function () {
    expect(res.status).to.equal(200);
  });
}
