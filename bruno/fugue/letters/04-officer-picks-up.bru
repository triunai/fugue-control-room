meta {
  name: Officer picks the claim up (200)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/claims/{{claimId}}/pickup
  body: none
  auth: bearer
}

auth:bearer {
  token: {{officerToken}}
}

headers {
  If-Match: {{claimEtag}}
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("claimEtag", res.headers["etag"]);
  }
}

tests {
  test("200 UnderReview", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("UnderReview");
  });
}
