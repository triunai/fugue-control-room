meta {
  name: Customers answer 404 module.disabled while the module is off
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/customers?limit=1
  body: none
  auth: inherit
}

tests {
  test("404 module.disabled, not 403", function () {
    expect(res.status).to.equal(404);
    expect(res.body.code).to.equal("module.disabled");
  });
}
