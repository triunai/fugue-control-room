meta {
  name: Reactivate customer
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/customers/{{customerId}}/reactivate
  body: none
  auth: none
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("etag", res.headers["etag"]);
  }
}

tests {
  test("200 and Active again", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("Active");
  });
}
