meta {
  name: Update without If-Match (428)
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/api/v1/customers/{{customerId}}
  body: json
  auth: none
}

body:json {
  {
    "name": "Should Not Apply",
    "email": "{{emailLower}}",
    "phone": null
  }
}

tests {
  test("problem code is customer.if_match_required", function () {
    expect(res.headers["content-type"]).to.include("application/problem+json");
    expect(res.body.code).to.equal("customer.if_match_required");
  });
  test("status is 428 (needs the owner's MapStatus)", function () {
    expect(res.status).to.equal(428);
  });
}
