meta {
  name: Officer sets the reserve (SGD 1,000.00 = 100000 minor units)
  type: http
  seq: 11
}

put {
  url: {{baseUrl}}/api/v1/claims/{{claimId}}/reserve
  body: json
  auth: bearer
}

auth:bearer {
  token: {{officerToken}}
}

headers {
  If-Match: {{claimEtag}}
}

body:json {
  { "amountMinor": 100000 }
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("claimEtag", res.headers["etag"]);
  }
}

tests {
  test("200 and staff see the reserve", function () {
    expect(res.status).to.equal(200);
    expect(res.body.reserveMinor).to.equal(100000);
  });
}
