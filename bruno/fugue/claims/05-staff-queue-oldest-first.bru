meta {
  name: Staff queue: unassigned Submitted claims, oldest first
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/claims?status=Submitted&assigned=none&limit=100
  body: none
  auth: bearer
}

auth:bearer {
  token: {{officerToken}}
}

tests {
  test("200, includes the claim, ordered oldest first", function () {
    expect(res.status).to.equal(200);
    expect(res.body.map(function (c) { return c.id; })).to.include(bru.getVar("claimId"));
    const times = res.body.map(function (c) { return Date.parse(c.submittedAt); });
    expect(times).to.eql(times.slice().sort(function (a, b) { return a - b; }));
  });
}
