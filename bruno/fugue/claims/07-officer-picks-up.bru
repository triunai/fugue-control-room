meta {
  name: Officer picks the claim up (200, UnderReview, new ETag)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/claims/{{claimId}}/pickup
  body: none
  auth: bearer
}

auth:bearer {
  token: {{officerToken}}
}

headers {
  If-Match: {{claimEtag}}
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("claimEtag", res.headers["etag"]);
  }
}

tests {
  test("200, UnderReview, assigned, new ETag", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("UnderReview");
    expect(res.body.assignedOfficerName).to.equal("Dev Staff");
    expect(res.headers["etag"]).to.not.equal(bru.getVar("submitEtag"));
  });
}
