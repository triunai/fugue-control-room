meta {
  name: minAgeDays=1 leaves out a claim submitted a moment ago
  type: http
  seq: 33
}

get {
  url: {{baseUrl}}/api/v1/claims?officerId={{assignedOfficerId}}&minAgeDays=1&limit=100
  body: none
  auth: bearer
}

auth:bearer {
  token: {{officerToken}}
}

tests {
  test("200 and the new claim is not there", function () {
    expect(res.status).to.equal(200);
    expect(res.body.map(function (c) { return c.id; })).to.not.include(bru.getVar("claimId"));
  });
}
