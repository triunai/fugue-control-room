meta {
  name: Claimant answers the question (back to UnderReview)
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/api/v1/claims/{{claimId}}/info-requests/{{infoRequestId}}/response
  body: json
  auth: bearer
}

auth:bearer {
  token: {{claimantToken}}
}

headers {
  If-Match: {{claimEtag}}
}

body:json {
  { "answer": "Photos attached to the email." }
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("claimEtag", res.headers["etag"]);
  }
}

tests {
  test("200, UnderReview again, no open question", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("UnderReview");
    expect(res.body.openInfoRequest).to.equal(null);
  });
}
