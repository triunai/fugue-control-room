meta {
  name: Manager settles the claim (Settled)
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api/v1/claims/{{claimId}}/settle
  body: none
  auth: bearer
}

auth:bearer {
  token: {{managerToken}}
}

headers {
  If-Match: {{claimEtag}}
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("claimEtag", res.headers["etag"]);
  }
}

tests {
  test("200, Settled", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("Settled");
    expect(res.body.settledAt).to.be.a("string");
  });
}
