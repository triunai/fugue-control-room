meta {
  name: Officer approves SGD 800.00 (within the reserve)
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/api/v1/claims/{{claimId}}/decision
  body: json
  auth: bearer
}

auth:bearer {
  token: {{officerToken}}
}

headers {
  If-Match: {{claimEtag}}
}

body:json {
  { "outcome": "approve", "amountMinor": 80000, "reason": "Covered under section 4." }
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("claimEtag", res.headers["etag"]);
  }
}

tests {
  test("200, Approved, amount and reason recorded", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("Approved");
    expect(res.body.approvedAmountMinor).to.equal(80000);
  });
}
