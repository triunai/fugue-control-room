meta {
  name: Workload carries oldestOpenClaimId per officer
  type: http
  seq: 37
}

get {
  url: {{baseUrl}}/api/v1/claims/workload
  body: none
  auth: bearer
}

auth:bearer {
  token: {{officerToken}}
}

tests {
  test("200 and every officer row has the field", function () {
    expect(res.status).to.equal(200);
    expect(res.body.officers.length).to.be.at.least(1);
    res.body.officers.forEach(function (o) { expect(o).to.have.property("oldestOpenClaimId"); });
  });
}
