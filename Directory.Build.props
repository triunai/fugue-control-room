<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!--
      Deliberate choice: the owner targets .NET 8 to match the CV / interview context. .NET 8 support
      ended 2026-11-10, so NETSDK1138 ("target framework is out of support") would otherwise fail the
      build under TreatWarningsAsErrors. NuGet vulnerability audit stays ON: a vulnerable package is
      upgraded, not silenced.
    -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>
</Project>
