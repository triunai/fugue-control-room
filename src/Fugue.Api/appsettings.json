{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal"
      }
    }
  },
  "Auth": {
    "Issuer": "fugue",
    "Audience": "fugue-api",
    "AccessTokenMinutes": 15
  },
  "RateLimiting": {
    "Auth": { "PerIpPermits": 20, "PerEmailPermits": 5, "WindowSeconds": 60, "PerEmailConcurrency": 2 }
  },
  "AllowedHosts": "*"
}
