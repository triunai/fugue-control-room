{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal"
      }
    }
  },
  "Auth": {
    "Issuer": "fugue",
    "Audience": "fugue-api",
    "AccessTokenMinutes": 15
  },
  "Audit": {
    "Enabled": true,
    "MaxChangesBytes": 16384,
    "CaptureClientIp": true,
    "UnauthenticatedRowsPerIpPerMinute": 30,
    "PartialMaskPersonalData": true,
    "MaskedProperties": [],
    "PartialMaskedProperties": [],
    "ExcludedEntities": []
  },
  "RateLimiting": {
    "Auth": { "PerIpPermits": 20, "PerEmailPermits": 5, "WindowSeconds": 60, "PerEmailConcurrency": 2, "EmailCeilingPermits": 50, "EmailCeilingWindowSeconds": 900 }
  },
  "AllowedHosts": "*"
}
