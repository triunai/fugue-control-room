<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <UserSecretsId>fugue-api-5b0c3b7e</UserSecretsId>
    <!-- XML doc comments feed the OpenAPI document (summaries on actions and DTOs). CS1591 (missing comment) stays off: only what is documented is published. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mediator.Abstractions" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Mediator.SourceGenerator" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fugue.Application\Fugue.Application.csproj" />
    <ProjectReference Include="..\Fugue.Domain\Fugue.Domain.csproj" />
    <ProjectReference Include="..\Fugue.Infrastructure\Fugue.Infrastructure.csproj" />
  </ItemGroup>
</Project>
