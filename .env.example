# Copy to .env (untracked) or use `dotnet user-secrets`. Placeholders only - never commit real values.

# Local Postgres (docker compose). Same password in both lines.
POSTGRES_PASSWORD=REPLACE_ME
# Host port for the container. Change it (and the port below) if a local Postgres already uses 5432.
POSTGRES_PORT=5432
ConnectionStrings__Postgres="Host=localhost;Port=5432;Database=fugue;Username=fugue;Password=REPLACE_ME"

# Read-only Postgres role for agent tooling (runbook agent-tooling). The compose Postgres creates fugue_readonly on a fresh volume with this password
# (dev default shown; local database only). The postgres-readonly MCP server in .mcp.json reads FUGUE_READONLY_DATABASE_URI; use your POSTGRES_PORT.
# FUGUE_READONLY_PASSWORD=fugue_readonly_dev
FUGUE_READONLY_DATABASE_URI=postgresql://fugue_readonly:fugue_readonly_dev@localhost:5432/fugue # secrets-scan:ignore (dev default, local only)

# JWT signing key (S3). base64 of at least 32 random bytes: `openssl rand -base64 32`. Prefer `dotnet user-secrets set Auth:SigningKey <value>`
# (project src/Fugue.Api). The host refuses to start with a missing, short or placeholder key. Issuer and audience default in appsettings.
Auth__SigningKey=GENERATE_WITH_openssl_rand_base64_32

# Docker compose stack (runbook 10): the containers read the signing key from AUTH_SIGNING_KEY (same value rules as above).
AUTH_SIGNING_KEY=GENERATE_WITH_openssl_rand_base64_32
# Optional host ports for the stack (defaults shown).
# API_PORT=5081
# WEB_PORT=8080

# Audit search (D-058, runbook 06). The compose stack runs Meilisearch with this master key (16+ bytes: `openssl rand -base64 32`; the quickstart sed fills it).
MEILI_MASTER_KEY=GENERATE_WITH_openssl_rand_base64_32
# MEILI_PORT=7700
# A host-run API (dotnet run) searches only when these are set; without them GET /api/v1/audit/search answers 503 search.unavailable.
# Search__Meilisearch__Url=http://localhost:7700
# Search__Meilisearch__ApiKey=<the same master key>

# Kafka (runbook 12). Webhooks is the default; Both adds Kafka and needs `docker compose --profile kafka up` (the broker). Host port of the broker below.
# EVENTS_PUBLISHER=Webhooks
# KAFKA_PORT=19092
# A host-run API (dotnet run) publishes to Kafka with: Events__Publisher=Both  Events__Kafka__BootstrapServers=localhost:19092

# Tenancy toggle (ADR-003). Off by default.
Tenancy__Enabled=false
