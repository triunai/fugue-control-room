# Copy to .env (untracked) or use `dotnet user-secrets`. Placeholders only - never commit real values.

# Supabase-hosted Postgres via the transaction pooler (port 6543).
ConnectionStrings__Postgres=Host=REPLACE_ME.pooler.supabase.com;Port=6543;Database=postgres;Username=REPLACE_ME;Password=REPLACE_ME;SSL Mode=Require;Trust Server Certificate=true;No Reset On Close=true

# JWT validation (tenant is resolved from a verified claim after authentication)
Jwt__Issuer=REPLACE_ME
Jwt__Audience=REPLACE_ME
Jwt__SigningKey=REPLACE_ME

# Stripe (test mode only)
Stripe__SecretKey=sk_test_REPLACE_ME
Stripe__WebhookSecret=whsec_REPLACE_ME
