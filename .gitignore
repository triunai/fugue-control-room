# Secrets and local config (never commit real values)
.env
.env.*
!.env.example
appsettings.*.local.json
secrets.json
*.pfx
*.pem

# OS / tooling
.DS_Store
node_modules/
.omc/

# Beads: LOCAL task queue only. Nothing beads-related is ever committed.
