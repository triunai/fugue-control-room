{
  "name": "fugue",
  "private": true,
  "version": "0.0.0",
  "description": "Repo tooling only (git hooks, commit linting). The application is .NET.",
  "scripts": {
    "prepare": "lefthook install",
    "trace": "node scripts/spine/trace-index.mjs",
    "test:scripts": "node --test scripts/*.test.mjs scripts/spine/*.test.mjs",
    "api:test": "cd bruno/fugue && bru run --env local",
    "db:script": "dotnet ef migrations script --idempotent --project src/Fugue.Infrastructure --startup-project src/Fugue.Infrastructure -o artifacts/db/migrate.sql",
    "api:openapi": "FUGUE_OPENAPI_UPDATE=1 dotnet test tests/Fugue.Tests --filter \"FullyQualifiedName~OpenApiContractTests\"",
    "api:test:compose": "cd bruno/fugue && bru run --env compose",
    "mutation:claim": "cd tests/Fugue.MutationTests && dotnet dotnet-stryker -p Fugue.Domain.csproj -m \"**/Claims/Claim.cs\" -O ../../artifacts/mutation/claim",
    "mutation:redactor": "cd tests/Fugue.MutationTests && dotnet dotnet-stryker -p Fugue.Infrastructure.csproj -m \"**/Audit/AuditRedactor.cs\" -O ../../artifacts/mutation/audit-redactor",
    "mutation:idempotency": "cd tests/Fugue.MutationTests && dotnet dotnet-stryker -p Fugue.Api.csproj -m \"**/Idempotency/IdempotencyKeyHeader.cs\" -O ../../artifacts/mutation/idempotency-key-header",
    "perf:queue": "k6 run perf/k6/claims-queue.js",
    "perf:submit": "k6 run perf/k6/claims-submit.js",
    "perf:race": "k6 run perf/k6/claims-pickup-race.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@usebruno/cli": "^4.4.0",
    "lefthook": "^1.7.0"
  }
}
